# ==========================================
# Server Configuration
# ==========================================
NODE_ENV="development"
PORT=5000
APP_URL="http://localhost:3000"

# ==========================================
# PostgreSQL Database (Neon / Supabase / Local)
# Example: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
# ==========================================
DATABASE_URL="postgresql://neondb_owner:npg_example@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Security & JWT Tokens
# ==========================================
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key_at_least_32_characters"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key_at_least_32_characters"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# Default Admin Credentials (For Evaluation)
# ==========================================
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@courier.com"
ADMIN_PASSWORD="Admin@Password123!"

# ==========================================
# Redis Configuration (Upstash / Local)
# ==========================================
REDIS_USER="default"
REDIS_PASSWORD="your_upstash_redis_password"
REDIS_HOST="your-redis-host.upstash.io"
REDIS_PORT=6379

# ==========================================
# Google Social Login (GCP OAuth 2.0)
# ==========================================
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# ==========================================
# Stripe Payment Gateway
# ==========================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_KEY="whsec_your_stripe_webhook_signing_secret"

# ==========================================
# Cloudinary (File & Document Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==========================================
# Email Service (Nodemailer / SMTP)
# ==========================================
SMTP_USER="your_smtp_username"
SMTP_PASSWORD="your_smtp_app_password"
EMAIL_SENDER="Courier Service <no-reply@courierservice.com>"
